# Copy to .env only if you want the paid LLM mapping step. Never commit .env.
# The code reads these from the environment; export them or use `set -a; source .env; set +a`.

# none (default, rules only) | fake (offline stand-in, NOT a real measurement) | anthropic (paid)
LLM_PROVIDER=none
LLM_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=
